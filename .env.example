# ──────────────────────────────────────────────
# Club Dragon — Variables de entorno
# ──────────────────────────────────────────────
# Copia este archivo a .env.local y rellena los valores.
# En Vercel, cada variable se configura con scope Production o Preview
# desde el dashboard o con `vercel env add <VAR> <production|preview>`.

# ── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Autenticación ─────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=your-jwt-secret

# ── Telegram ──────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_GROUP_ID=-1001234567890
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername

# ── Vercel KV / Upstash (rate limiting) ───────
KV_REST_API_URL=https://your-kv.upstash.io
KV_REST_API_TOKEN=your-kv-token

# ── Cron ──────────────────────────────────────
# Generar con: openssl rand -hex 32
CRON_SECRET=your-cron-secret
